[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=22
compiler.cppstd=20
compiler.libcxx=libc++

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:cflags=["-ffile-prefix-map=/__w/tt-client/tt-client=/tt-client", "-fmacro-prefix-map=/__w/tt-client/tt-client=/tt-client", "-ffile-prefix-map=/workspace/tt-client=/tt-client", "-fmacro-prefix-map=/workspace/tt-client=/tt-client"]
tools.build:cxxflags=["-Wno-unused-command-line-argument", "-ffile-prefix-map=/__w/tt-client/tt-client=/tt-client", "-fmacro-prefix-map=/__w/tt-client/tt-client=/tt-client", "-ffile-prefix-map=/workspace/tt-client=/tt-client", "-fmacro-prefix-map=/workspace/tt-client=/tt-client"]
